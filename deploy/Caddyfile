# Caddy inside the tailnet only (it shares the Tailscale container's network). Plain HTTP:
# the tailnet's WireGuard tunnel already encrypts every request end to end.
{
	admin off
	auto_https off
}

:80 {
	encode zstd gzip

	handle /api/* {
		reverse_proxy api:8000
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		X-Frame-Options DENY
	}
}
