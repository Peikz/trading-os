# Copy to deploy/.env (never commit it) and fill in. chmod 600 deploy/.env
#
# A Tailscale auth key: admin console → Settings → Keys → Generate auth key
# (reusable off, pre-approved). Used once; the state volume keeps the login.
TS_AUTHKEY=tskey-auth-REPLACE-ME
# The server's name in your tailnet: the site is http://<TS_HOSTNAME>.<your-tailnet>.ts.net/
TS_HOSTNAME=trading-os
# A fine-grained GitHub token: only the data repo, Contents read and write.
GH_TOKEN=github_pat_REPLACE-ME
# Absolute path of the data repo clone on the server
DATA_DIR=/opt/trading-os/trading-os-data
# Seconds between data repo pulls
PULL_EVERY=600
